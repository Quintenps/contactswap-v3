{
  "name": "@contactswap/api",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/validate-local-env.mjs",
    "dev": "wrangler dev",
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply contactswap_production --remote",
    "infra:r2:lifecycle:list": "wrangler r2 bucket lifecycle list contactswap-photos",
    "infra:r2:lifecycle:apply": "wrangler r2 bucket lifecycle set contactswap-photos --file infrastructure/r2-lifecycle.json"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "hono": "^4.13.12"
  }
}
