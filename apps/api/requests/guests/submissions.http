@baseUrl = http://127.0.0.1:8787
@guestToken = {{$dotenv GUEST_TOKEN}}

# Each successful submission consumes its link; use a different unused token for each example.
### Submit synthetic guest contact details (multipart, without a photo)
POST {{baseUrl}}/api/guest/links/{{guestToken}}/submissions
Content-Type: multipart/form-data; boundary=ContactSwapGuestBoundary

--ContactSwapGuestBoundary
Content-Disposition: form-data; name="name"

Morgan Rivera
--ContactSwapGuestBoundary
Content-Disposition: form-data; name="email"

morgan.rivera@example.invalid
--ContactSwapGuestBoundary
Content-Disposition: form-data; name="address"

42 Example Avenue, Sampleville, ZZ 00000
--ContactSwapGuestBoundary
Content-Disposition: form-data; name="birthday"

1992-07-14
--ContactSwapGuestBoundary
Content-Disposition: form-data; name="phone"

+31600000001
--ContactSwapGuestBoundary
Content-Disposition: form-data; name="org"

Larkspur Creative Studio
--ContactSwapGuestBoundary
Content-Disposition: form-data; name="title"

Senior Product Designer
--ContactSwapGuestBoundary--

### Submit synthetic guest contact details with a photo
POST {{baseUrl}}/api/guest/links/{{guestToken}}/submissions
Content-Type: multipart/form-data; boundary=ContactSwapGuestPhotoBoundary

--ContactSwapGuestPhotoBoundary
Content-Disposition: form-data; name="name"

Morgan Rivera
--ContactSwapGuestPhotoBoundary
Content-Disposition: form-data; name="email"

morgan.rivera@example.invalid
--ContactSwapGuestPhotoBoundary
Content-Disposition: form-data; name="address"

42 Example Avenue, Sampleville, ZZ 00000
--ContactSwapGuestPhotoBoundary
Content-Disposition: form-data; name="birthday"

1992-07-14
--ContactSwapGuestPhotoBoundary
Content-Disposition: form-data; name="phone"

+31600000001
--ContactSwapGuestPhotoBoundary
Content-Disposition: form-data; name="org"

Larkspur Creative Studio
--ContactSwapGuestPhotoBoundary
Content-Disposition: form-data; name="title"

Senior Product Designer
--ContactSwapGuestPhotoBoundary
Content-Disposition: form-data; name="picture"; filename="sample-guest-profile.jpg"
Content-Type: image/jpeg

< ../fixtures/sample-guest-profile.jpg
--ContactSwapGuestPhotoBoundary--
