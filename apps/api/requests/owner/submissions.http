@baseUrl = http://127.0.0.1:8787
@adminToken = {{$dotenv ADMIN_TOKEN}}
@submissionId = {{$dotenv SUBMISSION_ID}}

### List retained guest submissions
GET {{baseUrl}}/api/owner/submissions
Authorization: Bearer {{adminToken}}
Accept: application/json

### Read a guest submission
GET {{baseUrl}}/api/owner/submissions/{{submissionId}}
Authorization: Bearer {{adminToken}}
Accept: application/json

### Download a guest submission as vCard 4.0
GET {{baseUrl}}/api/owner/submissions/{{submissionId}}/vcard
Authorization: Bearer {{adminToken}}
Accept: text/vcard
