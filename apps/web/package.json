{
  "name": "@contactswap/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "deploy": "VITE_API_BASE_URL=${VITE_API_BASE_URL:-https://contactswap-api.quinten.dev} VITE_PUBLIC_APP_ORIGIN=${VITE_PUBLIC_APP_ORIGIN:-https://contactswap.quinten.dev} npm run build && wrangler pages deploy"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "jsdom": "^26.1.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  }
}
